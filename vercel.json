{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/atlas/infra/status",
      "destination": "https://ggmanzcgtlrvqfoccgsh.supabase.co/functions/v1/atlas-infra-status"
    },
    {
      "source": "/finance/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/health/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/atlas/infra/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "0"
        }
      ]
    },
    {
      "source": "/healthz",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
