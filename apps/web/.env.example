# Public browser configuration. Never place a Supabase secret or service-role key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Optional local preview override. Production Vite builds default to the
# deployed JWT-protected atlas-cloudflare-seed-build-once Supabase function.
# Never place a provider API key, service-role key, or other secret in VITE_ variables.
# VITE_ATLAS_TELEPHONY_FUNCTION_SLUG=atlas-communication-telephony
