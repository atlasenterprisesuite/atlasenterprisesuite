{
  "name": "atlas-enterprise-suite",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/web run build && node scripts/write-deployment-manifest.mjs apps/web/dist/deployment.json",
    "typecheck": "npm --workspace apps/web run typecheck",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "verify:edge": "node scripts/verify-edge-source.mjs",
    "verify:python": "node scripts/verify-python.mjs",
    "verify:neural": "node scripts/verify-neural-integrity.mjs",
    "verify:production:global": "node scripts/verify-global-production.mjs",
    "verify:all": "npm audit --audit-level=high && npm run typecheck && npm run test:unit && npm run test:integration && npm run verify:edge && npm run verify:python && npm run verify:neural && npm run build",
    "verify:cloudflare": "npm audit --audit-level=high && npm run typecheck && npm run test:unit && npm run test:integration && npm run verify:edge && npm run verify:neural && npm run build",
    "atlas:mcp:http": "node scripts/start-atlas-orchestrator.mjs",
    "atlas:mcp:stdio": "node --experimental-strip-types --experimental-loader=./apps/atlas-orchestrator/atlas-ts-loader.mjs apps/atlas-orchestrator/src/stdio.ts",
    "postinstall": "node scripts/install-render-local-ai.mjs"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "^25.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.7.2",
    "vite": "6.4.3",
    "vitest": "5.0.1"
  }
}
